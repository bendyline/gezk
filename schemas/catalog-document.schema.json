{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bendyline.github.io/gezk/schemas/catalog-document.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "topicPath": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
      }
    },
    "markdown": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "sourceRevision": {
      "type": "string"
    },
    "sourceUpdatedAt": {
      "type": "string"
    },
    "attribution": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "title",
    "slug",
    "language",
    "topicPath",
    "markdown"
  ]
}
